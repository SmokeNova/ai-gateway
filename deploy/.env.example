# /srv/gateway/.env on the VM (mode 0600). Never commit the real file.
# Generate keys with:  openssl rand -hex 32

# Encrypts every stored provider key. Keep a copy in your password manager:
# losing it means losing every stored key.
ENCRYPTION_KEY=

# Encrypts the periodic DB backup. Use a different key from ENCRYPTION_KEY.
FREEAPI_DB_BACKUP_KEY=

# Exact hostnames, comma-separated, no ports or wildcards: the public domain
# and the Tailscale name the admin dashboard is reached on.
ALLOWED_HOSTS=gw.example.com,gateway-vm.your-tailnet.ts.net

# Public hostname Caddy serves (and gets a TLS certificate for).
GATEWAY_DOMAIN=gw.example.com
# Contact address for the TLS certificate authority.
ACME_EMAIL=you@example.com

# Image to run. CI deploys pin an exact gateway-vX.Y.Z tag.
GATEWAY_IMAGE=ghcr.io/smokenova/ai-gateway:latest
